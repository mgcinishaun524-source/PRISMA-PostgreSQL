# GEMINI_API_KEY: API Key for Gemini model services
GEMINI_API_KEY=

# APP_URL: Host URL for this service
APP_URL=

# DATABASE_URL: PostgreSQL database connection string (Supabase connection pooler on port 6543)
DATABASE_URL="postgresql://user:password@localhost:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct / Session connection string for migrations (port 5432)
DIRECT_URL="postgresql://user:password@localhost:5432/postgres"
